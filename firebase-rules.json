                ".validate": "newData.hasChildren(['n','d','x','z']) && newData.child('d').isNumber() && newData.child('d').val() >= 0 && newData.child('d').val() <= 20 && newData.child('n').isString() && newData.child('n').val().length <= 40",
                "n": {},
